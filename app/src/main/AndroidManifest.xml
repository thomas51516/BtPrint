<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!-- Bluetooth (Android 12+) : connexion aux imprimantes appairées.
         SCAN est demandé car la librairie appelle cancelDiscovery() avant de se connecter. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Serveur HTTP local sur 127.0.0.1 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Service au premier plan (file d'impression + serveur local) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BtPrint">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activité invisible : reçoit les partages et les liens btprint: -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BtPrint.Transparent">

            <!-- Menu "Partager" : PDF, images, texte -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Ouvrir avec" pour un PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Liens btprint:base64,... ou btprint:text,... (depuis une page web) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="btprint" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PrintService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
